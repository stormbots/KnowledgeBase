      "y": 3220
    },
    {
      "height": 60,
      "id": "83d215b6866a9c40",
      "styleAttributes": {
      },
      "text": "Gyro Aiming",
      "type": "text",
      "width": 260,
      "x": 760,
      "y": 3480
    },
    {
      "color": "1",
      "height": 160,
      "id": "fa54a67a83e5f16c",
      "styleAttributes": {
      },
      "text": "# Vision Goals\n- Controlled Autos\n- Automated Alignment\n- Automated positioning",
      "type": "text",
      "width": 260,
      "x": 760,
      "y": 3700
    },
    {
      "height": 246,
      "id": "90a68ae3126f4b5f",
      "styleAttributes": {
      },
      "text": "Sensing\n- Triggers\n- Encoders\n- Switches\n- Lasercan Distance\n- Lasercan Presence",
      "type": "text",
      "width": 260,
      "x": 1360,
      "y": 4095
    },
    {
      "height": 60,
      "id": "7b9863f057fc16a4",
      "styleAttributes": {
      },
      "text": "Field-Oreinted Drive",
      "type": "text",
