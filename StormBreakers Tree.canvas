      "x": -280,
      "y": 3820
    },
    {
      "height": 120,
      "id": "33ec680a2063e2d4",
      "styleAttributes": {
      },
      "text": "## Telemetry\n- Reading robot inputs\n- Graphs\n- AdvantageScope?",
